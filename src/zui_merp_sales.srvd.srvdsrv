@EndUserText: {
  label: 'Service Definition for Sales UI'
}
@ObjectModel: {
  leadingEntity: {
    name: 'ZMERP_C_SALESORDER'
  }
}
define service ZUI_MERP_SALES
  provider contracts odata_v4_ui {
  expose ZMERP_C_SALESORDER    as SalesOrder;
  expose ZMERP_C_SALESORDERITM as SalesOrderItem;
  expose ZMERP_C_GOODSISSUE    as GoodsIssue;
  expose ZMERP_C_GOODSISSUEITM as GoodsIssueItem;
  expose ZMERP_C_COMPANY_CODE  as CompanyCode;
  expose ZMERP_C_WAREHOUSE     as Warehouse;
  expose ZMERP_C_VAT_RATE      as VatRate;
  expose ZMERP_C_ITEM_GROUP    as ItemGroup;
  expose ZMERP_C_ITEM          as Item;
  expose ZMERP_C_BUS_PARTNER   as BusinessPartner;
}