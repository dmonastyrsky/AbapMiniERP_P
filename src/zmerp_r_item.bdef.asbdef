managed implementation in class ZBP_MERP_R_ITEM unique;
strict ( 2 );
with draft;
extensible;

define behavior for ZMERP_R_ITEM alias Item
persistent table zmerp_item
extensible
draft table zmerp_item_d
etag master LocalLastChangedAt
lock master total etag LastChangedAt
early numbering
authorization master ( global )
{
  create;
  update;
  delete ( precheck );

  field ( readonly ) ItemCode;
  field ( mandatory ) Description, ItemTypeCode, ItemGroupCode, DefaultVatCode, BaseUnitOfMeasure;

  determination setDefaultVatCode on modify { field ItemGroupCode; }

  validation validateMandatoryFields on save { create; update; field Description, ItemTypeCode, ItemGroupCode, DefaultVatCode, BaseUnitOfMeasure; }

  draft action Edit;
  draft action Activate optimized;
  draft action Discard;
  draft action Resume;
  draft determine action Prepare
  {
    validation validateMandatoryFields;
  }

  mapping for zmerp_item
  {
    ItemCode           = item_code;
    Description        = description;
    Article            = article;
    ItemTypeCode       = item_type;
    ItemGroupCode      = item_group_code;
    DefaultVatCode     = default_vat_code;
    BaseUnitOfMeasure  = base_unit_of_measure;
    IsBlocked          = is_blocked;
    CreatedBy          = created_by;
    CreatedAt          = created_at;
    LocalLastChangedBy = local_last_changed_by;
    LocalLastChangedAt = local_last_changed_at;
    LastChangedAt      = last_changed_at;
  }
}