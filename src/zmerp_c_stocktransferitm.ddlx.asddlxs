@Metadata.layer: #CUSTOMER

@UI.headerInfo: {
  typeName: 'Stock Transfer Item',
  typeNamePlural: 'Stock Transfer Items',
  title: { value: 'ItemNo' },
  description: { value: 'ItemCode' }
}

@UI.presentationVariant: [{
  sortOrder: [{ by: 'ItemNo', direction: #ASC }]
}]

annotate view ZMERP_C_STOCKTRANSFERITM with
{
  @UI.facet: [
    {
      id: 'ItemDataSection',
      purpose: #STANDARD,
      type: #COLLECTION,
      label: 'Item Details',
      position: 10
    },
    {
      id: 'ItemGeneralSubSection',
      purpose: #STANDARD,
      type: #FIELDGROUP_REFERENCE,
      parentId: 'ItemDataSection',
      label: 'General Information',
      targetQualifier: 'ItemGeneralGroup',
      position: 10
    },
    {
      id: 'AdminItemSection',
      purpose: #STANDARD,
      type: #FIELDGROUP_REFERENCE,
      label: 'Administrative Data',
      targetQualifier: 'AdminGroup',
      position: 20,
      hidden: true
    }
  ]

  @UI.hidden: true
  ItemUUID;

  @UI.hidden: true
  HeaderUUID;

  @UI.lineItem: [{ position: 10, importance: #HIGH }]
  @UI.fieldGroup: [{ qualifier: 'ItemGeneralGroup', position: 10 }]
  ItemNo;

  @UI.lineItem: [{ position: 20, importance: #HIGH }]
  @UI.fieldGroup: [{ qualifier: 'ItemGeneralGroup', position: 20 }]
  ItemCode;

  @UI.lineItem: [{ position: 30, importance: #HIGH }]
  @UI.fieldGroup: [{ qualifier: 'ItemGeneralGroup', position: 30 }]
  Quantity;

  @EndUserText.label: 'In Stock'
  @UI.lineItem: [{ position: 40, importance: #HIGH, label: 'In Stock' }]
  @UI.fieldGroup: [{ qualifier: 'ItemGeneralGroup', position: 40, label: 'In Stock' }]
  StockQuantity;

  @UI.hidden: true
  UnitOfMeasure;

  @UI.fieldGroup: [{ qualifier: 'AdminGroup', position: 10 }]
  CreatedBy;

  @UI.fieldGroup: [{ qualifier: 'AdminGroup', position: 20 }]
  CreatedAt;

  @UI.fieldGroup: [{ qualifier: 'AdminGroup', position: 30 }]
  LocalLastChangedBy;

  @UI.fieldGroup: [{ qualifier: 'AdminGroup', position: 40 }]
  LocalLastChangedAt;

  @UI.fieldGroup: [{ qualifier: 'AdminGroup', position: 50 }]
  LastChangedAt;
}