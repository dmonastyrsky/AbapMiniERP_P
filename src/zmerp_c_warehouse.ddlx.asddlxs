@Metadata.layer: #CUSTOMER

@UI.headerInfo: {
  typeName: 'Warehouse',
  typeNamePlural: 'Warehouses',
  title: { value: 'WarehouseName' },
  description: { value: 'WarehouseCode' }
}

@UI.presentationVariant: [{
  sortOrder: [{ by: 'WarehouseCode', direction: #ASC }]
}]

annotate view ZMERP_C_WAREHOUSE with
{
  @UI.facet: [
    {
      id: 'GeneralHeaderSection',
      purpose: #STANDARD,
      type: #FIELDGROUP_REFERENCE,
      label: 'General Information',
      targetQualifier: 'GeneralGroup',
      position: 10
    },
    {
      id: 'AdminHeaderSection',
      purpose: #STANDARD,
      type: #FIELDGROUP_REFERENCE,
      label: 'Administrative Data',
      targetQualifier: 'AdminGroup',
      position: 20,
      hidden: true
    }
  ]

  @UI.textArrangement: #TEXT_SEPARATE
  @UI.lineItem: [{ position: 10, importance: #HIGH }]
  @UI.fieldGroup: [{ qualifier: 'GeneralGroup', position: 10 }]
  @UI.selectionField: [{ position: 10 }]
  WarehouseCode;

  @UI.lineItem: [{ position: 20, importance: #HIGH }]
  @UI.fieldGroup: [{ qualifier: 'GeneralGroup', position: 20 }]
  @UI.selectionField: [{ position: 20 }]
  WarehouseName;

  @UI.lineItem: [{ position: 30, importance: #HIGH }]
  @UI.fieldGroup: [{ qualifier: 'GeneralGroup', position: 30 }]
  @UI.selectionField: [{ position: 30 }]
  @UI.textArrangement: #TEXT_FIRST
  CompanyCode;
  
  @UI.lineItem: [{ position: 40, importance: #HIGH }]
  @UI.fieldGroup: [{ qualifier: 'GeneralGroup', position: 40}]
  IsBlocked;

  @UI.fieldGroup: [{ qualifier: 'AdminGroup', position: 10 }]
  CreatedBy;

  @UI.fieldGroup: [{ qualifier: 'AdminGroup', position: 20 }]
  CreatedAt;

  @UI.fieldGroup: [{ qualifier: 'AdminGroup', position: 30 }]
  LocalLastChangedBy;

  @UI.fieldGroup: [{ qualifier: 'AdminGroup', position: 40 }]
  LocalLastChangedAt;

  @UI.fieldGroup: [{ qualifier: 'AdminGroup', position: 50 }]
  LastChangedAt;
}